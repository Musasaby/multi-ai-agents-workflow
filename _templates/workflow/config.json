{
  "child_agent": {
    "command_template": "opencode run \"{prompt}\"",
    "profile": "",
    "timeout_seconds": 1800,
    "idle_timeout_seconds": 600,
    "isolate_xdg": false,
    "healthcheck_command": "",
    "warmup_command": ""
  },
  "test_command": "",
  "verify_before_commit": false,
  "branch_per_group": true,
  "quality_gate": {
    "steps": [
      { "name": "typecheck", "command": "", "blocking": true },
      { "name": "test", "command": "", "blocking": true },
      { "name": "lint", "command": "", "blocking": false }
    ],
    "child_dispatch_command": ""
  },
  "max_fix_retries": 2,
  "comprehension_check": {
    "enabled": false,
    "questions_per_task": 3
  },
  "task_sizing": {
    "max_acceptance_criteria": 5,
    "max_changed_files": 3,
    "max_reference_files": 5,
    "design_detail": "skeleton"
  },
  "text_refine": {
    "skill": null,
    "targets": ["summary", "confirm", "commit", "pr_body", "task_done", "tasks"],
    "reader": "informed"
  },
  "upstream": {
    "url": "https://github.com/Musasaby/multi-ai-agents-workflow.git",
    "branch": "dist"
  }
}
